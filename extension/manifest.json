{
  "manifest_version":3,
  "name":"Mailon - Evidence Trust 2030",
  "version":"2.0.0",
  "description":"Multilingual evidence-driven digital trust assistant.",
  "permissions":["activeTab","scripting","storage","contextMenus","sidePanel"],
  "host_permissions":["<all_urls>","http://127.0.0.1:8000/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_title":"Open Mailon"},
  "side_panel":{"default_path":"panel.html"},
  "content_scripts":[{"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_idle"}]
}